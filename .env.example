# AURA Firewall — Environment Variables
# Copy this file to .env and adjust values for your environment.
# Docker Compose injects these variables automatically via the 'environment' block.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (used in Docker)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/safety_firewall
# SQLite (for local development without Docker)
# DATABASE_URL=sqlite:///./app.db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker hostname: redis (matches docker-compose service name)
REDIS_URL=redis://redis:6379/0
# Local development without Docker:
# REDIS_URL=redis://localhost:6379/0

# ── General ───────────────────────────────────────────────────────────────────
ENV=development

# ── Phase 1: Rate Limiting ────────────────────────────────────────────────────
# Set to false to disable rate limiting entirely (e.g., during unit tests).
RATE_LIMIT_ENABLED=true

# Maximum number of /evaluate-action calls allowed per agent_id per window.
RATE_LIMIT_REQUESTS=60

# Rolling window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# ── Phase 2/4: Agent Authentication ──────────────────────────────────────────
# Set to true to require X-Agent-Key on POST /evaluate-action.
# When false, system runs in Phase 1 compatibility mode.
AUTH_ENABLED=true

# ── Phase 4: Production Hardening ────────────────────────────────────────────
# The initial admin credentials must be provided on first startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-in-production

# JWT settings
JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production
JWT_EXPIRE_MINUTES=30

# Operator Login Rate Limiting
AUTH_LOGIN_RATE_LIMIT_REQUESTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Phase 2: Seeder API keys (only used when AUTH_ENABLED=true) ───────────────
# Obtain these values from POST /api/v1/agents/register responses.
# SEED_KEY_RESEARCH_BOT=aura-<key returned at registration>
# SEED_KEY_DEV_BOT=aura-<key returned at registration>
# SEED_KEY_OPS_BOT=aura-<key returned at registration>
